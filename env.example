# ==============================================
# CAPSTONE PROJECT - ENVIRONMENT VARIABLES
# ==============================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-strong-password-here
MONGO_DATABASE=capstone

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# Encryption Configuration
MASTER_ENCRYPTION_KEY=your-master-encryption-key-32-chars

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Firebase Configuration (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id

# LLM and AI Configuration
HUGGING_FACE_HUB_TOKEN=your-huggingface-token
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LLM_API_BASE=http://my_vllm:8000/v1

# Vector Database Configuration
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Python Server Configuration
PYTHONPATH=/app

# ==============================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.example .env
# 2. Update the values with your actual configuration
# 3. Keep .env file private and never commit it to version control
# ============================================== 